{
  "$schema": "./node_modules/@nestjs/cli/lib/config/schema.json",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "tsconfig.build.json"
  },
  "assets": [
    {
      "include": "../generated/prisma/**/*",
      "outDir": "dist/generated/prisma",
      "watchAssets": true
    }
  ]
}