// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//_______________________________________
enum UserRole {
  OWNER
  ADMIN
  MANAGER
  EMPLOYEE
}

enum Plan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum BusinessType {
  GENERIC
  PET_GROOMING
  SPA
  BEAUTY_SALON
  BARBER_SHOP
}

enum ClientType {
  PERSON
  COMPANY
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum VisitStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  QR
  OTHER
}

//_______________________________________

model Tenant {
  id   String @id @default(uuid()) @db.Uuid
  name String
  plan Plan   @default(FREE)

  businessType BusinessType @default(GENERIC)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  sucursales  Sucursal[]

  clients      Client[]
  services     Service[]
  appointments Appointment[]
  visits       Visit[]
}

model User {
  id String @id @default(uuid()) @db.Uuid

  email    String @unique
  password String

  firstName String?
  lastName  String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  Membership[]
  sessions     Session[]
  sucursales   UserSucursal[]
  appointments Appointment[]
  visits       Visit[]
}

model Membership {
  id String @id @default(uuid()) @db.Uuid

  userId   String @db.Uuid
  tenantId String @db.Uuid

  role UserRole @default(EMPLOYEE)

  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model Session {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  token  String @unique

  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Sucursal {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  name      String
  latitude  Float
  longitude Float
  direccion String?
  telefono  String?
  correo    String?

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  UserSucursal[]

  appointments Appointment[]
  visits       Visit[]
  payments     Payment[]

  services BranchService[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model UserSucursal {
  id String @id @default(uuid()) @db.Uuid

  userId     String @db.Uuid
  sucursalId String @db.Uuid

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sucursal Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  @@unique([userId, sucursalId]) // 👈 no duplicar accesos
  @@index([sucursalId])
}

model Client {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid

  type ClientType @default(PERSON)

  fullName String

  phone String?

  email String?

  documentNumber String?

  birthDate DateTime?

  address String?

  notes String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  appointments Appointment[]
  visits       Visit[]

  @@unique([tenantId, documentNumber])
  @@index([tenantId])
}

model Service {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid

  name String

  description String?

  basePrice Decimal @db.Decimal(12, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  visitDetails VisitDetail[]

  branches BranchService[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model BranchService {
  sucursalId String @db.Uuid
  serviceId  String @db.Uuid

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sucursal Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([sucursalId, serviceId])
}

model Appointment {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid

  sucursalId String @db.Uuid

  clientId String @db.Uuid

  userId String? @db.Uuid

  scheduledAt DateTime

  status AppointmentStatus @default(PENDING)

  visit Visit?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  sucursal Sucursal @relation(fields: [sucursalId], references: [id])

  client Client @relation(fields: [clientId], references: [id])

  user User? @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([sucursalId])
  @@index([clientId])
  @@index([userId])
}

model Visit {
  id String @id @default(uuid()) @db.Uuid

  tenantId String @db.Uuid

  sucursalId String @db.Uuid

  clientId String @db.Uuid

  userId String @db.Uuid

  appointmentId String? @unique @db.Uuid

  status VisitStatus @default(OPEN)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  sucursal Sucursal @relation(fields: [sucursalId], references: [id])

  client Client @relation(fields: [clientId], references: [id])

  user User @relation(fields: [userId], references: [id])

  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  details VisitDetail[]

  payments Payment[]

  @@index([tenantId])
  @@index([clientId])
  @@index([userId])
  @@index([sucursalId])
}

model VisitDetail {
  id String @id @default(uuid()) @db.Uuid

  visitId String @db.Uuid

  serviceId String @db.Uuid

  quantity Int @default(1)

  serviceName String

  unitPrice Decimal @db.Decimal(12, 2)

  totalPrice Decimal @db.Decimal(12, 2)

  notes String?

  createdAt DateTime @default(now())

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  service Service @relation(fields: [serviceId], references: [id])

  @@index([visitId])
  @@index([serviceId])
}

model Payment {
  id String @id @default(uuid()) @db.Uuid

  visitId String @db.Uuid

  sucursalId String @db.Uuid

  amount Decimal @db.Decimal(12, 2)

  method PaymentMethod

  reference String?

  notes String?

  paidAt DateTime @default(now())

  createdAt DateTime @default(now())

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  sucursal Sucursal @relation(fields: [sucursalId], references: [id])

  @@index([visitId])
  @@index([sucursalId])
  @@index([paidAt])
}
